    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "new": "node scripts/new-component.mjs",
    "smoke": "node scripts/smoke.mjs",
    "frames": "node scripts/frames.mjs",
    "shot": "node scripts/shot.mjs",
    "sync-recipes": "node scripts/sync-recipes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@unseenco/taxi": "1.9.1",
    "animejs": "4.5.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "matter-js": "0.20.0",
    "ogl": "1.0.11",
    "postprocessing": "6.39.5",
    "three": "0.186.0"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "vite": "8.3.5"
  }
